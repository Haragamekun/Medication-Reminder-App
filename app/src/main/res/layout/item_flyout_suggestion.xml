<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/flyout_item_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvSuggestionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:drawablePadding="14dp"
        app:drawableTint="@color/accent_teal"
        android:maxLines="1"
        android:ellipsize="end"/>

    <ImageButton
        android:id="@+id/btnRemoveHistory"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:src="@drawable/ic_remove_circle_x"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_cancel"
        android:visibility="gone"/>

</LinearLayout>
