<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_sheet_drag_handle_bg"
        android:alpha="0.4"/>

    <!-- Header Row with Back Button labeled 'Frequency' -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:id="@+id/btnBackFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/accent_teal"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat"
                android:textColor="@color/accent_teal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Schedule"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <!-- Main Selection Card: Radio Group -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/liquid_glass_card"
        android:padding="16dp"
        android:elevation="0dp"
        android:layout_marginBottom="16dp">

        <RadioGroup
            android:id="@+id/rgFrequencyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Only Once -->
            <RadioButton
                android:id="@+id/rbOnlyOnce"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Only once"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:buttonTint="@color/accent_teal"
                android:paddingStart="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_stroke"/>

            <!-- Every Day -->
            <RadioButton
                android:id="@+id/rbEveryDay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Every day"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:checked="true"
                android:buttonTint="@color/accent_teal"
                android:paddingStart="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_stroke"/>

            <!-- Every Week -->
            <RadioButton
                android:id="@+id/rbEveryWeek"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Every week"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:buttonTint="@color/accent_teal"
                android:paddingStart="12dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- Sub-section: Only Once Options (Specific Date) -->
    <LinearLayout
        android:id="@+id/containerOnlyOnce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/liquid_glass_card"
        android:padding="16dp"
        android:elevation="0dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <!-- Specific Date Toggle Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specific date"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSpecificDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/accent_teal"
                app:trackTint="@color/nav_unselected"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <!-- Alarm Rings On Row (Expanded when Specific Date is ON) -->
        <LinearLayout
            android:id="@+id/rowAlarmRingsOn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/suggestion_pill_background"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Alarm rings on"
                android:textColor="@color/text_primary"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvSelectedDateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October 11, 2026"
                android:textColor="@color/accent_teal"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/accent_teal"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Sub-section: Every Week Options (Day Selector Bar) -->
    <LinearLayout
        android:id="@+id/containerEveryWeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/liquid_glass_card"
        android:padding="16dp"
        android:elevation="0dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repeat on days"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- 7 Circular Day Buttons (S, M, T, W, T, F, S) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btnDaySun"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="S"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnDayMon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="M"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnDayTue"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="T"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnDayWed"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="W"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnDayThu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="T"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnDayFri"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="F"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnDaySat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="S"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/suggestion_pill_background"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Save Frequency Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveFrequency"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="SAVE SCHEDULE"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:letterSpacing="0.05"
        android:backgroundTint="@color/accent_teal"
        app:cornerRadius="18dp"
        android:elevation="0dp"/>

</LinearLayout>
