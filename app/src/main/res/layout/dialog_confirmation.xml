<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:padding="28dp"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background">

    <ImageView
        android:id="@+id/ivConfirmIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@android:drawable/ic_dialog_alert"
        app:tint="#EF4444"
        android:contentDescription="@string/desc_warning_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/confirm_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ivConfirmIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/confirm_default_msg"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmMessage"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- CANCEL BUTTON ON THE LEFT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAction"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            app:strokeColor="@color/button_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp" />

        <!-- CONFIRM BUTTON ON THE RIGHT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAction"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/btn_confirm"
            android:textColor="@android:color/white"
            android:backgroundTint="#EF4444"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:elevation="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
