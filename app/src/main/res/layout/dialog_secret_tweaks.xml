<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background">

    <!-- Top Header Row -->
    <RelativeLayout
        android:id="@+id/headerSecretTweaks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSecretTweaksTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secret Tweaks"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <ImageButton
            android:id="@+id/btnSecretTweaksClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/btn_close"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/scrollSecretTweaks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerSecretTweaks"
        app:layout_constraintBottom_toTopOf="@id/btnSecretTweaksDone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Preferred Scanner Expandable Header / Button -->
            <LinearLayout
                android:id="@+id/btnPreferredScannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/liquid_glass_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/accent_teal"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferred Scanner"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentScannerMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Both (ML Kit + Gemini API)"
                        android:textColor="@color/accent_teal"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivExpandChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/accent_teal"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Expand & Collapse Panel -->
            <LinearLayout
                android:id="@+id/panelPreferredScannerChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/liquid_glass_card"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select OCR Scanning Method:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/rgScannerChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Option 1: Google ML Kit -->
                    <RadioButton
                        android:id="@+id/rbScannerMlKit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Google ML Kit (On-Device)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:button="@drawable/custom_radio_button_selector"
                        android:paddingStart="10dp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fast on-device text recognition. Works 100% offline with zero network needed."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/glass_stroke"
                        android:alpha="0.4"
                        android:layout_marginBottom="10dp" />

                    <!-- Option 2: Gemini API -->
                    <RadioButton
                        android:id="@+id/rbScannerGemini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gemini API (Cloud AI)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:button="@drawable/custom_radio_button_selector"
                        android:paddingStart="10dp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Direct visual AI analysis. Accurately extracts medication, dosage, &amp; multi-prescriptions."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/glass_stroke"
                        android:alpha="0.4"
                        android:layout_marginBottom="10dp" />

                    <!-- Option 3: Both (Combined Hybrid) -->
                    <RadioButton
                        android:id="@+id/rbScannerBoth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Both (ML Kit + Gemini) [Default]"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:button="@drawable/custom_radio_button_selector"
                        android:paddingStart="10dp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Combines fast ML Kit text recognition with Gemini AI visual validation for maximum precision."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="4dp" />

                </RadioGroup>

            </LinearLayout>

            <!-- Gemini AI Chat Option Row -->
            <LinearLayout
                android:id="@+id/btnGeminiChatOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/liquid_glass_card"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chat_bubble_plus"
                    app:tint="@color/accent_teal"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini AI Chat"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interactive real-time health assistant"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/accent_teal"
                    android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSecretTweaksDone"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@string/btn_close"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        android:backgroundTint="@color/accent_teal"
        app:cornerRadius="14dp"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/scrollSecretTweaks"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
