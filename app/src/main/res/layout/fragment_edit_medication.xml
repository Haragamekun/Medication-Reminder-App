<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:paddingTop="12dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_sheet_drag_handle_bg"
        android:alpha="0.4"/>

    <!-- Scrollable Input Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSheetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medication Intel"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"/>

                    <LinearLayout
                        android:id="@+id/verificationBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/status_pill_background"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivVerificationStatus"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/baseline_check_24"
                            app:tint="@color/accent_teal"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/tvVerificationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERIFIED"
                            android:textColor="@color/accent_teal"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnRescan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="@drawable/liquid_glass_card"
                    app:tint="@color/accent_teal"
                    android:contentDescription="@string/desc_rescan"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVerificationMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/snooze_orange"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- Name Input with Floating Label -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MEDICINE NAME"
                app:hintTextColor="@color/accent_teal"
                app:boxStrokeColor="@color/accent_teal"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:layout_marginBottom="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMedicineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:inputType="textPersonName"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dosage Input with Floating Label -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="DOSAGE (e.g. 500mg)"
                app:hintTextColor="@color/accent_teal"
                app:boxStrokeColor="@color/accent_teal"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:layout_marginBottom="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDosage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:inputType="text"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Frequency & Repeat Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Frequency Selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREQUENCY"
                        android:textColor="@color/accent_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectFrequencyCount"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="1 time a day"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="start|center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        app:strokeColor="@color/button_stroke"
                        app:strokeWidth="1.2dp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="end"
                        app:iconTint="@color/text_secondary"
                        app:iconSize="20dp"
                        android:textAllCaps="false"/>
                </LinearLayout>

                <!-- Repeat Selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REPEAT"
                        android:textColor="@color/accent_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectRepeat"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Every day"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="start|center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        app:strokeColor="@color/button_stroke"
                        app:strokeWidth="1.2dp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="end"
                        app:iconTint="@color/text_secondary"
                        app:iconSize="20dp"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Reception Times Container -->
            <LinearLayout
                android:id="@+id/containerReceptionTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"/>

            <!-- Ringtone Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALARM RINGTONE"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectRingtone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Default Ringtone"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/button_stroke"
                app:strokeWidth="1.2dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="12dp"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_lock_idle_alarm"
                app:iconTint="@color/accent_teal"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Anchored Sticky Bottom Bar for CONFIRM & SAVE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:background="@drawable/sticky_header_background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CONFIRM &amp; SAVE"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.05"
            android:backgroundTint="@color/accent_teal_dark"
            app:cornerRadius="18dp"
            android:elevation="0dp"/>
    </LinearLayout>

</LinearLayout>
