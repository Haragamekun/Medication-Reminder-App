<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- Scrollable Medication Grid (Passes smoothly under sticky search bar) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedicationGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp"
        android:paddingTop="80dp"
        android:paddingBottom="120dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Sticky Floating Search Header -->
    <FrameLayout
        android:id="@+id/onlineSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/liquid_glass_card"
        android:elevation="0dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/searchBarContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/desc_search_icon"/>

            <EditText
                android:id="@+id/etOnlineSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/hint_search_medicine"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:imeOptions="actionSearch"
                android:inputType="text"/>

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_remove_circle_x"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary"
                android:visibility="gone"
                android:contentDescription="@string/btn_cancel"/>

            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_mic"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/accent_teal"
                android:contentDescription="@string/desc_voice_search"/>
        </LinearLayout>

        <!-- Voice Search Reveal Overlay (Fills search bar with mic icon color) -->
        <FrameLayout
            android:id="@+id/voiceRevealOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <View
                android:id="@+id/voiceRevealView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/voiceListeningContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivListeningMic"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_mic"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/desc_voice_search"/>

                <TextView
                    android:id="@+id/tvListeningStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_listening"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Did You Mean Suggestion Pill -->
    <LinearLayout
        android:id="@+id/didYouMeanContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="@drawable/suggestion_pill_background"
        android:elevation="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/onlineSearchContainer"
        app:layout_constraintStart_toStartOf="@id/onlineSearchContainer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_did_you_mean"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSuggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/noResultsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/msg_no_results"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        app:drawableTopCompat="@drawable/ic_search"
        android:drawablePadding="16dp"
        android:alpha="0.5"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/onlineSearchContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dismiss Overlay for Flyout -->
    <View
        android:id="@+id/flyoutDismissOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Flyout Suggestions -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFlyoutSuggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/glass_card_bg"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/onlineSearchContainer"
        app:layout_constraintStart_toStartOf="@id/onlineSearchContainer"
        app:layout_constraintEnd_toEndOf="@id/onlineSearchContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFlyoutHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_recent_searches"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:letterSpacing="0.1"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFlyoutSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="240dp"
                android:paddingVertical="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/noInternetView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/text_secondary"
            android:alpha="0.5"
            android:contentDescription="@string/desc_no_internet_icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_no_internet"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_check_network"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
