<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMessageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:animateLayoutChanges="false"
    android:paddingVertical="6dp">

    <!-- User Message Container (Right Aligned) -->
    <LinearLayout
        android:id="@+id/containerUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:animateLayoutChanges="false"
        android:background="@drawable/liquid_glass_button"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginStart="60dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- AI Message Container (Left Aligned Liquid Glass Card) -->
    <LinearLayout
        android:id="@+id/containerAiMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:animateLayoutChanges="false"
        android:background="@drawable/liquid_glass_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginEnd="40dp"
        android:visibility="gone">

        <!-- AI Speaker Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/badge_teal_bg"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini AI"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

</LinearLayout>
