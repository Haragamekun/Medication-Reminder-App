<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MainActivity">



    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Daily Wellness Track"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Main Content ViewPager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavCard"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp">

            <!-- Sliding Indicator -->
            <View
                android:id="@+id/navIndicator"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/nav_indicator"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/navHomeContainer"
                app:layout_constraintEnd_toEndOf="@+id/navHomeContainer"/>

            <LinearLayout
                android:id="@+id/navHomeContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/navHistoryContainer">

                <ImageButton
                    android:id="@+id/navHome"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:background="@android:color/transparent"
                    app:tint="@color/nav_selected"
                    android:contentDescription="@string/desc_home"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_home"
                    android:textSize="11sp"
                    android:textColor="@color/nav_selected"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navHistoryContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/navHomeContainer"
                app:layout_constraintEnd_toStartOf="@+id/fabScanContainer">

                <ImageButton
                    android:id="@+id/navHistory"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:background="@android:color/transparent"
                    app:tint="@color/nav_unselected"
                    android:contentDescription="@string/desc_history"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:id="@+id/tvNavHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_history"
                    android:textSize="11sp"
                    android:textColor="@color/nav_unselected"/>
            </LinearLayout>

            <!-- Floating Action Button Styled as Scan -->
            <FrameLayout
                android:id="@+id/fabScanContainer"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/liquid_glass_button"
                android:contentDescription="@string/desc_scan"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/fabScan"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/desc_camera_icon" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/navOnlineContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/fabScanContainer"
                app:layout_constraintEnd_toStartOf="@+id/navSettingsContainer">

                <ImageButton
                    android:id="@+id/navOnlineInfo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:background="@android:color/transparent"
                    app:tint="@color/nav_unselected"
                    android:contentDescription="@string/desc_online"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:id="@+id/tvNavOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_search"
                    android:textSize="11sp"
                    android:textColor="@color/nav_unselected"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettingsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/navOnlineContainer"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/navSettings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_settings_ios"
                    android:background="@android:color/transparent"
                    app:tint="@color/nav_unselected"
                    android:contentDescription="@string/desc_settings"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_settings"
                    android:textSize="11sp"
                    android:textColor="@color/nav_unselected"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Camera Guide Overlay (Re-styled) -->
    <FrameLayout
        android:id="@+id/cameraGuideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_background"
        android:visibility="gone"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="30dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_guide_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="280dp"
                android:layout_height="200dp"
                android:background="@drawable/scan_frame_border"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_guide_subtitle"
                android:textColor="@color/text_hint"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnCancelScan"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/white"
                    android:background="@android:color/transparent"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnProceedScan"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="@string/btn_start_scan"
                    android:backgroundTint="@color/accent_teal_dark"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- AI Analysis Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loading_overlay_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/accent_teal_dark" />

        <TextView
            android:id="@+id/tvLoadingMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/loading_main"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/loading_sub"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Circular Reveal View for Theme Animation (Global) -->
    <View
        android:id="@+id/themeRevealView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:visibility="invisible"
        android:elevation="100dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>