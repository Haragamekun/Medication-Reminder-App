<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvMultiScanHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multiple prescriptions detected, click which one"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnCloseMultiScan"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"/>

        <ImageButton
            android:id="@+id/btnCloseMultiScan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/liquid_glass_card"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/btn_cancel"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <!-- Subtitle Tip -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap any green outlined circle to select that medication"
        android:textColor="@color/accent_teal"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"/>

    <!-- Custom Interactive Circle Overlay View -->
    <com.example.ocrmedicationapp.PrescriptionCircleOverlayView
        android:id="@+id/overlayCircleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#10000000"/>

</LinearLayout>
