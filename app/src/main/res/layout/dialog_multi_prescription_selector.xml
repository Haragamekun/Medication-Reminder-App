<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp">

    <!-- Header Section with Count Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvMultiScanHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 Medications Detected"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 DETECTED"
            android:textColor="@color/accent_teal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/badge_teal_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="10dp" />

        <ImageButton
            android:id="@+id/btnCloseMultiScan"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/liquid_glass_card"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/btn_cancel" />
    </LinearLayout>

    <!-- Subtitle Tip -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap any green outlined circle to select that medication"
        android:textColor="@color/accent_teal"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"/>

    <!-- Custom Interactive Circle Overlay View -->
    <com.example.ocrmedicationapp.PrescriptionCircleOverlayView
        android:id="@+id/overlayCircleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#10000000"/>

</LinearLayout>
